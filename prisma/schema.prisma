generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================

enum Role {
  TEAM_MEMBER
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ReviewAction {
  APPROVED
  REQUESTED_CHANGES
}

// ==============================
// USER
// ==============================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TEAM_MEMBER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports Report[]
  reviews ReportReview[] @relation("Reviewer")
}

// ==============================
// PROJECT
// ==============================

model Project {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports Report[]
}

// ==============================
// REPORT
// ==============================

model Report {
  id        Int      @id @default(autoincrement())
  userId    Int
  projectId Int

  weekStart DateTime
  weekEnd   DateTime

  status ReportStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id])

  versions ReportVersion[]
  reviews  ReportReview[]

  @@unique([userId, weekStart])
  @@index([status])
  @@index([projectId])
  @@index([weekStart])
}

// ==============================
// REPORT VERSION
// ==============================

model ReportVersion {
  id            Int      @id @default(autoincrement())
  reportId      Int
  versionNumber Int

  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  tasks        ReportVersionTask[]
  nextTasks    ReportVersionNextTask[]
  blockers     ReportVersionBlocker[]
  achievements ReportVersionAchievement[]
  hours        ReportVersionHours?
  reviews      ReportReview[]

  @@unique([reportId, versionNumber])
}

// ==============================
// REPORT TASKS (completed)
// ==============================

model ReportVersionTask {
  id              Int @id @default(autoincrement())
  reportVersionId Int

  taskName          String
  priority          TaskPriority
  plannedPercentage Float
  actualPercentage  Float
  status            TaskStatus
  plannedHours      Float
  spentHours        Float
  deliverable       String?
  sortOrder         Int

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
}

// ==============================
// NEXT WEEK TASKS
// ==============================

model ReportVersionNextTask {
  id              Int @id @default(autoincrement())
  reportVersionId Int

  taskName    String
  description String?
  sortOrder   Int

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
}

// ==============================
// BLOCKERS
// ==============================

model ReportVersionBlocker {
  id              Int @id @default(autoincrement())
  reportVersionId Int

  description String
  isKeyIssue  Boolean @default(false)
  sortOrder   Int

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
}

// ==============================
// ACHIEVEMENTS
// ==============================

model ReportVersionAchievement {
  id              Int @id @default(autoincrement())
  reportVersionId Int

  description      String
  isKeyAchievement Boolean @default(false)
  sortOrder        Int

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
}

// ==============================
// HOURS
// ==============================

model ReportVersionHours {
  id              Int @id @default(autoincrement())
  reportVersionId Int @unique

  development   Float @default(0)
  testing       Float @default(0)
  meetings      Float @default(0)
  documentation Float @default(0)
  other         Float @default(0)
  totalHours    Float @default(0)

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
}

// ==============================
// REPORT REVIEWS
// ==============================

model ReportReview {
  id              Int @id @default(autoincrement())
  reportId        Int
  reportVersionId Int
  reviewerId      Int

  action  ReviewAction
  comment String?

  createdAt DateTime @default(now())

  report        Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  reviewer      User          @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([reportId])
  @@index([reportVersionId])
}
